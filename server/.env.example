# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/workspace_scheduler

# Authentication / Security
JWT_SECRET=dummy_super_secret_jwt_key_at_least_32_bytes_long

# Google OAuth
GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Client & CORS
CLIENT_URL=http://localhost:5173

# Authorization & Demo Flags
ADMIN_EMAILS=admin@example.com
ENABLE_DEMO_ADMIN=true
